{
  "name": "video-subtitle-translator",
  "version": "1.0.0",
  "description": "Video/Audio subtitle generation and translation platform on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "server": "node -r ts-node/register src/server.ts",
    "server:dev": "nodemon -r ts-node/register src/server.ts",
    "build": "tsc --skipLibCheck",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/server.js",
    "docker:build": "docker build -t video-subtitle-translator:latest .",
    "docker:run": "docker run -p 3000:3000 -e UPLOAD_DIR=/data/uploads -v uploads:/data/uploads video-subtitle-translator:latest",
    "test": "vitest",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "keywords": [
    "cloudflare",
    "workers",
    "video",
    "subtitle",
    "translation",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/ai": "^1.1.16",
    "@cloudflare/containers": "^0.3.3",
    "@types/express": "^4.17.25",
    "@types/uuid": "^10.0.0",
    "express": "^4.22.1",
    "itty-router": "^5.0.23",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.39",
    "eslint": "^8.56.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "wrangler": "^3.26.0"
  }
}
